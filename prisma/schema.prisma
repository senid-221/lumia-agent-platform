generator client { provider = "prisma-client-js" }

datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { CUSTOMER AGENT ADMIN }
enum AgentStatus { PENDING ACTIVE SUSPENDED REJECTED }
enum VerificationStatus { PENDING VERIFIED REJECTED }
enum SubscriptionStatus { PENDING ACTIVE EXPIRED CANCELLED }
enum RequestStatus { PENDING MATCHED ACCEPTED IN_PROGRESS COMPLETED CANCELLED }

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  role         Role         @default(CUSTOMER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  agent        IremboAgent?
  sessions     Session[]
  requests     ServiceRequest[] @relation("CustomerRequests")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, createdAt])
}

model IremboService {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  category         String
  institution      String?
  description      String?
  requirements     Json?
  feeRwf           Int?
  processingTime   String?
  accountRequired  Boolean?
  officialUrl      String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  requests         ServiceRequest[]
  @@index([category, active])
}

model IremboAgent {
  id                 String             @id @default(cuid())
  userId             String             @unique
  displayName        String
  phone              String
  location           String
  serviceAreas       String[]
  bio                String?
  status             AgentStatus         @default(PENDING)
  verificationStatus VerificationStatus  @default(PENDING)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions      AgentSubscription[]
  requests           ServiceRequest[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  @@index([status, verificationStatus, location])
}

model AgentPlan {
  id           String             @id @default(cuid())
  name         String             @unique
  priceRwf     Int
  durationDays Int
  active       Boolean            @default(true)
  subscriptions AgentSubscription[]
}

model AgentSubscription {
  id        String             @id @default(cuid())
  agentId   String
  planId    String
  status    SubscriptionStatus  @default(PENDING)
  startsAt  DateTime?
  expiresAt DateTime?
  paymentRef String?
  agent     IremboAgent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  plan      AgentPlan           @relation(fields: [planId], references: [id])
  createdAt DateTime            @default(now())
  @@index([agentId, status, expiresAt])
}

model ServiceRequest {
  id            String          @id @default(cuid())
  customerId    String
  serviceId     String
  customerName  String
  customerPhone String
  description   String?
  location      String?
  status        RequestStatus   @default(PENDING)
  agentId       String?
  customer      User            @relation("CustomerRequests", fields: [customerId], references: [id], onDelete: Cascade)
  service       IremboService   @relation(fields: [serviceId], references: [id])
  agent         IremboAgent?    @relation(fields: [agentId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  @@index([serviceId, status])
}
