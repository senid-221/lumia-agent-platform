generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  AGENT
  TEACHER
  ADMIN
}

enum AgentStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum RequestStatus {
  PENDING
  MATCHED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  phone        String?          @unique
  passwordHash String
  role         Role             @default(CUSTOMER)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  agent        IremboAgent?
  teacher      Teacher?
  sessions     Session[]
  requests     ServiceRequest[] @relation("CustomerRequests")
  teacherRequests TeacherRequest[] @relation("CustomerTeacherRequests")
  notifications Notification[]
  partner      Partner?
  marketplaceOrders MarketplaceOrder[]
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, createdAt])
}

model IremboService {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  category         String
  institution      String?
  description      String?
  requirements     Json?
  feeRwf           Int?
  processingTime   String?
  accountRequired  Boolean?
  officialUrl      String?
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  requests         ServiceRequest[]
  @@index([category, active])
}

model IremboAgent {
  id                 String              @id @default(cuid())
  userId             String              @unique
  displayName        String
  phone              String
  location           String
  serviceAreas       String[]
  bio                String?
  status             AgentStatus         @default(PENDING)
  verificationStatus VerificationStatus  @default(PENDING)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions      AgentSubscription[]
  requests           ServiceRequest[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  @@index([status, verificationStatus, location])
}

model Teacher {
  id                 String             @id @default(cuid())
  userId             String             @unique
  displayName        String
  phone              String
  location           String
  technologies       String[]
  bio                String?
  status             AgentStatus        @default(PENDING)
  verificationStatus VerificationStatus @default(PENDING)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests           TeacherRequest[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  @@index([status, verificationStatus, location])
}

model TeacherRequest {
  id            String        @id @default(cuid())
  customerId    String
  teacherId     String
  technology    String
  customerName  String
  customerPhone String
  description   String?
  location      String?
  status        RequestStatus @default(PENDING)
  customer      User          @relation("CustomerTeacherRequests", fields: [customerId], references: [id], onDelete: Cascade)
  teacher       Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([teacherId, status])
  @@index([technology, status])
}

model AgentPlan {
  id            String              @id @default(cuid())
  name          String              @unique
  priceRwf      Int
  durationDays  Int
  active        Boolean             @default(true)
  subscriptions AgentSubscription[]
}

model AgentSubscription {
  id         String             @id @default(cuid())
  agentId    String
  planId     String
  status     SubscriptionStatus  @default(PENDING)
  startsAt   DateTime?
  expiresAt  DateTime?
  paymentRef String?
  agent      IremboAgent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  plan       AgentPlan           @relation(fields: [planId], references: [id])
  createdAt  DateTime            @default(now())
  @@index([agentId, status, expiresAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}

model ServiceRequest {
  id            String          @id @default(cuid())
  customerId    String
  serviceId     String
  customerName  String
  customerPhone String
  description   String?
  location      String?
  status        RequestStatus   @default(PENDING)
  agentId       String?
  customer      User            @relation("CustomerRequests", fields: [customerId], references: [id], onDelete: Cascade)
  service       IremboService   @relation(fields: [serviceId], references: [id])
  agent         IremboAgent?    @relation(fields: [agentId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  @@index([serviceId, status])
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

model PlatformService {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Partner {
  id           String        @id @default(cuid())
  userId       String        @unique
  businessName String
  phone        String
  location     String
  description  String?
  status       PartnerStatus @default(PENDING)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  products     Product[]
  orders       MarketplaceOrder[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  @@index([status, location])
}

model Product {
  id          String        @id @default(cuid())
  partnerId   String
  name        String
  category    String
  description String?
  priceRwf    Int?
  imageUrl    String?
  productUrl  String?
  stock       Int           @default(0)
  status      ProductStatus @default(DRAFT)
  partner     Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  orderItems  MarketplaceOrderItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@index([category, status])
  @@index([partnerId, status])
}

model MarketplaceOrder {
  id               String        @id @default(cuid())
  partnerId        String
  customerId       String
  customerName     String
  customerPhone    String
  deliveryLocation String
  status           OrderStatus   @default(PENDING)
  notes            String?
  partner          Partner       @relation(fields: [partnerId], references: [id])
  customer         User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items            MarketplaceOrderItem[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  @@index([partnerId, status])
  @@index([customerId, createdAt])
}

model MarketplaceOrderItem {
  id        String           @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Int?
  order     MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product          @relation(fields: [productId], references: [id])
  @@unique([orderId, productId])
}
