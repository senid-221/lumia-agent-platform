{
  "name": "lumia-agent-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "npm run prisma:migrate && node dist/server.js",
    "prisma:generate": "./node_modules/.bin/prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "./node_modules/.bin/prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "10.0.2",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@prisma/client": "6.16.2",
    "@types/node": "24.4.0",
    "bcryptjs": "3.0.2",
    "dotenv": "17.2.2",
    "fastify": "5.5.0",
    "jose": "6.1.0",
    "zod": "4.1.5",
    "@whiskeysockets/baileys": "latest",
    "@fastify/cookie": "10.0.1",
    "exa-js": "latest"
  },
  "devDependencies": {
    "prisma": "6.16.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
